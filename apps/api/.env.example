# Local Compose Postgres (infra/docker-compose.yml). Copy to apps/api/.env.
DATABASE_URL=postgresql://checkout:checkout@localhost:5432/checkout
PORT=3001

# PSP sandbox — private key and integrity secret stay on the server.
PSP_BASE_URL=
PSP_PRIVATE_KEY=
PSP_INTEGRITY_SECRET=
PSP_POLL_INTERVAL_MS=1000
PSP_POLL_MAX_ATTEMPTS=15

